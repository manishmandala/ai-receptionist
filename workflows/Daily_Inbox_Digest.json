    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-sonnet-4-6",
          "mode": "list",
          "cachedResultName": "claude-sonnet-4-6"
        },
        "messages": {
          "values": [
            {
              "content": "=Here are the emails received in the last 24 hours, with their labels:\n\n{{ JSON.stringify($json.emails.map(e => ({\n  label: e.labels.filter(l => l.name.startsWith('Agent/')).map(l => l.name).join(','),\n  from: e.From,\n  subject: e.Subject,\n  snippet: e.snippet\n})), null, 2) }}"
            }
          ]
        },
        "options": {
          "system": "You are writing a morning digest for a real estate agent. They received the emails below overnight.  Write a brief, scannable summary in this exact format:  Good morning. Here's what came in overnight.  **Leads (X)** - [One line per lead: sender + brief context]  **Transactions (X)** - [One line per transaction email]  **Past clients (X)** - [One line each]  **Vendor (X)** and **Junk (X)** were auto-filed.  Voice rules: - Skip sections that have zero emails - No em dashes, no emojis - Sound human, not corporate - Use real names from the From field, not \"a lead\" or \"someone\" - Keep each line under 15 words - If no important mail came in, say \"Quiet morning. Nothing urgent overnight.\""
        }
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        576,
        0
      ],
      "id": "8d9b4a5c-bf49-4a14-9469-45416d2dbf7f",
